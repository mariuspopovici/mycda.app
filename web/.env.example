# Copy to .env.local (gitignored) and fill in from the Firebase console
# (Project settings → Your apps → Web app → SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mycda-c43c6.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mycda-c43c6
VITE_FIREBASE_STORAGE_BUCKET=mycda-c43c6.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
# The registered web app's ID (needed by the run explainer and App Check)
VITE_FIREBASE_APP_ID=
# Base URL of the api function
VITE_API_URL=https://us-central1-mycda-c43c6.cloudfunctions.net/api
# Set to "true" to use the local Firebase emulators (project demo-mycda) instead of production
VITE_USE_EMULATORS=false
# Run explainer (Firebase AI Logic, Gemini Developer API). Offered only when the App Check site key is set.
# reCAPTCHA Enterprise site key registered for the web app under App Check
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# For local development: a debug token registered under App Check → Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=
# Optional: the Gemini model (default gemini-3.5-flash)
VITE_GEMINI_MODEL=
