# Copy to .env.local (gitignored) and fill in from the Firebase console, or run
# `node scripts/env-from-legacy.mjs` to generate it from config/prod.env.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Base URL of the api function
VITE_API_URL=https://us-central1-mycda-c43c6.cloudfunctions.net/api
# Set to "true" to use the local Firebase emulators (project demo-mycda) instead of production
VITE_USE_EMULATORS=false
