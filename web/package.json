{
  "name": "web",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prerender": "node scripts/prerender.mjs",
    "build:site": "npm run build && npm run prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all-fixtures": "ALL_FIXTURES=1 vitest run src/core/__tests__/private.test.ts",
    "dev:emulators": "VITE_USE_EMULATORS=true vite"
  },
  "dependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/dropzone": "9.6.3",
    "@mantine/form": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@mantine/modals": "9.6.3",
    "@mantine/notifications": "9.6.3",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.104.1",
    "firebase": "12.19.0",
    "leaflet": "1.9.4",
    "plotly.js-basic-dist-min": "4.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@mariuspopovici/rho": "0.1.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.20.5",
    "@types/plotly.js": "3.0.14",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
