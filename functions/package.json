{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase serve --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test \"test/**/*.test.js\"",
    "test:all-fixtures": "ALL_FIXTURES=1 node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "fit-file-parser": "6.2.2"
  },
  "engines": {
    "node": "22"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.5",
    "globals": "16.5.0"
  }
}
