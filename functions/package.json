{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase serve --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test \"test/**/*.test.js\"",
    "test:all-fixtures": "ALL_FIXTURES=1 node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.5",
    "csv-parse": "7.0.3",
    "express": "^4.17.1",
    "fflate": "0.8.3",
    "firebase-admin": "^9.7.0",
    "firebase-functions": "^3.20.0",
    "fit-file-parser": "6.2.2",
    "mkdirp-promise": "^5.0.1",
    "node-gzip": "^1.1.2"
  },
  "devDependencies": {
    "eslint": "^4.12.0",
    "eslint-plugin-promise": "^3.6.0"
  },
  "engines": {
    "node": "22"
  },
  "private": true
