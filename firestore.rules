rules_version = '2';

// Every document belongs to a single user. Activities and user prefs carry the
// owner's uid; segments are owned through their parent activity.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsActivity(activityId) {
      return get(/databases/$(database)/documents/activities/$(activityId)).data.uid == request.auth.uid;
    }

    match /activities/{activityId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /segments/{segmentId} {
      allow read, delete: if signedIn() && ownsActivity(resource.data.activity);
      allow create: if signedIn() && ownsActivity(request.resource.data.activity);
      allow update: if signedIn()
        && ownsActivity(resource.data.activity)
        && request.resource.data.activity == resource.data.activity;
    }

    match /userprefs/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }
  }
}
