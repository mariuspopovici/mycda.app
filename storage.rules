rules_version = '2';

// Activity files live under userdata/{uid}/activities/ and are only accessible
// to their owner. Cloud Functions use the Admin SDK and bypass these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /userdata/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
