rules_version = '2';

// Activity files live under userdata/{uid}/activities/ and are only accessible
// to their owner. Cloud Functions use the Admin SDK and bypass these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /userdata/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // uploads are capped at 25 MB, matching the web app's limit
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
